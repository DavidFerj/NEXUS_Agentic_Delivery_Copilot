# Copy to .env for local development. Values below are non-production placeholders.
NEXUS_ENVIRONMENT=development
NEXUS_LOG_LEVEL=INFO
NEXUS_AUTH_MODE=development
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus_runtime:replace-with-runtime-password@postgres:5432/nexus
NEXUS_CORS_ORIGINS=http://localhost:3000
NEXUS_API_BASE_URL=http://api:8000
NEXT_PUBLIC_NEXUS_API_BASE_URL=http://localhost:8000

# Firebase Local Emulator Suite. Production uses App Hosting-provided configuration
# and Application Default Credentials; never commit service-account keys.
NEXUS_FIREBASE_PROJECT_ID=nexus-local
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nexus-local
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_API_KEY=local-emulator-only
NEXT_PUBLIC_FIREBASE_APP_ID=local-emulator-only
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

POSTGRES_DB=nexus
POSTGRES_USER=nexus_owner
POSTGRES_PASSWORD=replace-with-owner-password
POSTGRES_APP_USER=nexus_runtime
POSTGRES_APP_PASSWORD=replace-with-runtime-password

REDIS_PASSWORD=replace-with-local-password

MINIO_ROOT_USER=nexus-local
MINIO_ROOT_PASSWORD=replace-with-local-password

